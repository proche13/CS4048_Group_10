<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ZeroVelocity" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Keep the launch window visible in night mode instead of falling back to black. -->
        <item name="android:windowBackground">@drawable/auth_screen_background</item>
        <item name="android:statusBarColor">@color/auth_background_start</item>
        <item name="android:navigationBarColor">@color/auth_background_end</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Theme.ZeroVelocity" parent="Base.Theme.ZeroVelocity" />
</resources>
