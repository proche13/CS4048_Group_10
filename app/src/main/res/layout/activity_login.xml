<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/auth_screen_background"
    android:fillViewport="true">
    <!-- outer container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">
        <!-- MOst Polluted text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="MOST POLLUTED"
            android:textColor="@color/auth_brand_ink"
            android:textSize="34sp"
            android:textStyle="bold" />
        <!-- text below -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.85"
            android:text="Track drinks, vapes and cigarettes in one place"
            android:textAlignment="center"
            android:textColor="@color/auth_brand_ink"
            android:textSize="16sp" />
        <!-- Floating form panel -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/auth_surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/auth_card_stroke"
            app:strokeWidth="1dp">
            <!-- Container for text and input fields -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back"
                    android:textColor="@color/auth_text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="20dp"
                    android:text="Log in to continue your progress"
                    android:textColor="@color/auth_text_secondary"
                    android:textSize="15sp" />
                <!-- Email input -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ZeroVelocity.AuthInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/auth_text_primary"
                        android:textColorHint="@color/auth_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>
                <!-- Password input -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ZeroVelocity.AuthInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Password"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/auth_text_primary"
                        android:textColorHint="@color/auth_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>
                <!-- Login button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:minHeight="56dp"
                    android:text="Log In"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:backgroundTint="@color/auth_button"
                    app:cornerRadius="18dp" />
                <!-- Sign up text link -->
                <TextView
                    android:id="@+id/tv_go_to_sign_up"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:text="Don't have an account? Sign up"
                    android:textColor="@color/auth_link"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
