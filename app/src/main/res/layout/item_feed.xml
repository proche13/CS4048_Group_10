<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_feed_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/auth_surface">

    <!-- Header: profile pic + username/action + rank emoji -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/iv_feed_profile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/feed_profile_picture"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/tv_feed_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/auth_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_feed_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Full-width log image -->
    <ImageView
        android:id="@+id/iv_feed_log_image"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:contentDescription="@string/feed_log_image"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Action row: cheers, react, reaction summary, comment count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/tv_cheers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="🥂 0"
            android:textSize="15sp"
            android:textColor="@color/auth_text_secondary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_react"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="😄"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_reactions_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:textSize="14sp"
            android:textColor="@color/auth_text_secondary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_comment_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="💬 0"
            android:textSize="15sp"
            android:textColor="@color/auth_text_secondary" />

    </LinearLayout>

    <!-- Caption: drink details + description -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_feed_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/auth_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/ll_feed_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_feed_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/auth_text_primary"
                android:lineSpacingExtra="2dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_feed_description_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minHeight="36dp"
                android:gravity="center"
                android:textColor="@color/auth_link"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <!-- Comments preview -->
    <LinearLayout
        android:id="@+id/ll_comments_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_view_all_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:textColor="@color/auth_text_secondary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_comment_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/auth_text_primary"
            android:textSize="13sp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/tv_comment_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/auth_text_primary"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Comment input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/et_comment_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Add a comment..."
            android:textSize="13sp"
            android:textColor="@color/auth_text_primary"
            android:textColorHint="@color/auth_text_secondary"
            android:background="@null"
            android:maxLines="1"
            android:imeOptions="actionSend"
            android:inputType="textAutoCorrect" />

        <TextView
            android:id="@+id/tv_comment_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="Post"
            android:textColor="@color/auth_link"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Bottom divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/auth_card_stroke" />

</LinearLayout>
