{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["displayName", "displayNameLowercase"],
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "friendRequests": {
      "$targetUid": {
        ".read": "auth != null && auth.uid == $targetUid",
        "$senderUid": {
          ".write": "auth != null && (auth.uid == $senderUid || auth.uid == $targetUid)",
          ".validate": "newData.val() == null || (newData.hasChildren(['uid', 'displayName']) && newData.child('uid').val() == $senderUid && newData.child('displayName').isString())"
        }
      }
    },
    "sentRequests": {
      "$senderUid": {
        ".read": "auth != null && auth.uid == $senderUid",
        "$targetUid": {
          ".write": "auth != null && (auth.uid == $senderUid || (auth.uid == $targetUid && !newData.exists()))",
          ".validate": "newData.val() == null || newData.val() == true"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$friendUid": {
          ".write": "auth != null && (auth.uid == $uid || auth.uid == $friendUid)",
          ".validate": "newData.val() == null || (newData.hasChildren(['uid', 'displayName']) && newData.child('uid').val() == $friendUid && newData.child('displayName').isString())"
        }
      }
    },
    "consumptionLogs": {
      ".read": "auth != null",
      ".indexOn": ["userID", "timestamp"],
      "$eventId": {
        ".write": "auth != null && ((newData.exists() && newData.child('userID').val() == auth.uid) || (!newData.exists() && data.child('userID').val() == auth.uid))",
        "cheers": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.val() == null || newData.val() == true"
          }
        },
        "reactions": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.val() == null || newData.isString()"
          }
        },
        "comments": {
          "$commentId": {
            ".write": "auth != null && (newData.exists() ? newData.child('uid').val() == auth.uid : (data.child('uid').val() == auth.uid || data.parent().parent().child('userID').val() == auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'username', 'text', 'timestamp']) && newData.child('uid').val() == auth.uid && newData.child('text').isString() && newData.child('username').isString()"
          }
        }
      }
    },
    "Events": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
